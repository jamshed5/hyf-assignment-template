### NODE WEEK2 (TESTING)
### ======================
### BASE URL
### ======================
@baseUrl = http://localhost:3000/api/snippets


### ======================
### GET ALL (default)
### ======================
GET {{baseUrl}}


### ======================
### GET ALL (valid sort)
### ======================
GET {{baseUrl}}?sort=title desc


### ======================
### GET ALL (invalid sort format)
### ======================
GET {{baseUrl}}?sort=invalid


### ======================
### GET ALL (SQL injection attempt - Part A test)
### ======================
GET {{baseUrl}}?sort=created_at desc; DROP TABLE users;


### ======================
### SEARCH (valid)
### ======================
GET {{baseUrl}}/search?q=sql


### ======================
### SEARCH (missing query)
### ======================
GET {{baseUrl}}/search


### ======================
### PUBLIC FEED
### ======================
GET {{baseUrl}}/public


### ======================
### GET BY ID (valid)
### ======================
GET {{baseUrl}}/1


### ======================
### GET BY ID (invalid ID)
### ======================
GET {{baseUrl}}/abc


### ======================
### GET BY ID (not found)
### ======================
GET {{baseUrl}}/9999


### ======================
### CREATE SNIPPET (valid)
### ======================
POST {{baseUrl}}
Content-Type: application/json

{
  "title": "Test snippet",
  "contents": "console.log('hello')",
  "user_id": 1
}


### ======================
### CREATE SNIPPET (missing fields)
### ======================
POST {{baseUrl}}
Content-Type: application/json

{
  "title": ""
}


### ======================
### CREATE SNIPPET (invalid user_id)
### ======================
POST {{baseUrl}}
Content-Type: application/json

{
  "title": "Test",
  "contents": "Hello",
  "user_id": -1
}


### ======================
### UPDATE SNIPPET (valid)
### ======================
PUT {{baseUrl}}/1
Content-Type: application/json

{
  "title": "Updated title"
}


### ======================
### UPDATE SNIPPET (invalid ID)
### ======================
PUT {{baseUrl}}/abc
Content-Type: application/json

{
  "title": "Updated title"
}


### ======================
### UPDATE SNIPPET (not found)
### ======================
PUT {{baseUrl}}/9999
Content-Type: application/json

{
  "title": "Updated title"
}


### ======================
### DELETE SNIPPET (valid)
### ======================
DELETE {{baseUrl}}/16


